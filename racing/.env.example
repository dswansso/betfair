# Copy this file to racing/.env and fill in your own details.
# racing/.env is gitignored: never commit it or paste its contents anywhere.

BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_APP_KEY=

# "international" (betfair.com, the default) or "au" (betfair.com.au,
# for Australian and New Zealand accounts).
BETFAIR_REGION=international

# Optional: folder holding your client .crt and .key for certificate login.
# Leave blank to use interactive (username and password only) login.
BETFAIR_CERTS_DIR=

# Country codes for the test market listing, comma separated.
BETFAIR_COUNTRIES=GB,IE
